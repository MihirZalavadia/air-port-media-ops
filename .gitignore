# .gitignore for airport-media-ops

# ============================================
# SENSITIVE BUSINESS DATA — never commit
# ============================================

# Real client/lead contact data (templates OK, populated data NOT)
05_crm_and_outreach/lead_research/*.md
!05_crm_and_outreach/lead_research/_TEMPLATE.md
!05_crm_and_outreach/lead_research/.gitkeep

# Inventory with real pricing/contract data
06_inventory_dashboard/data/*.csv
06_inventory_dashboard/data/*.xlsx
!06_inventory_dashboard/data/inventory_template.csv

# Tender bid documents (often contain NDAs)
08_tender_intelligence/active_bids/

# Internal meeting notes (may contain confidential business strategy)
01_strategy_and_pitch/meeting_notes/*.md
!01_strategy_and_pitch/meeting_notes/.gitkeep

# Credentials, API keys, environment variables
.env
.env.local
.env.production
*.key
*.pem
credentials.json
secrets/

# ============================================
# STANDARD DEV IGNORES
# ============================================

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.vscode/
.idea/
.claude/settings.local.json
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Python (if any scripts get added)
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# Temp & cache
tmp_pdf_images/
*.tmp
*.bak
*.cache
.cache/

# ============================================
# WHAT TO ALWAYS COMMIT
# ============================================
# - CLAUDE.md, README.md, SESSION_STARTERS.md
# - All template files (_TEMPLATE.md, _template.csv)
# - All folder .gitkeep files
# - Strategy docs (90-day plan, client list — these are MINE, ok to track)
# - Brand assets (logos, style guides)
# - Website source code
# - Media kit source files
# - Email/WhatsApp/LinkedIn TEMPLATES (not populated outreach logs)

# raw inventory photography (102MB) — converted webps live in the site
updated images/

# built site packages
mukeshart_site_build*.zip
