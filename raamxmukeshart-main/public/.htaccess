# Legacy routes from the pre-July site version are still in Google's
# index but 404 now — 301 them to the airport page so their equity
# transfers and Google drops the dead URLs. Anchored patterns so real
# pages like /inventory/<slug>/ are untouched.
<IfModule mod_alias.c>
    RedirectMatch 301 ^/about/?$ https://mukeshart.in/airport/
    RedirectMatch 301 ^/gallery/?$ https://mukeshart.in/airport/
    RedirectMatch 301 ^/why-airport-media/?$ https://mukeshart.in/airport/
    RedirectMatch 301 ^/inventory/?$ https://mukeshart.in/airport/
</IfModule>

# Browser caching for the mukeshart.in static export (LiteSpeed/Apache).
# JS/CSS filenames are content-hashed by the Next build — safe to cache
# forever. Media files keep stable names (videos get re-cut in place),
# so they get short lifetimes. HTML must always revalidate or deploys
# take days to show up for repeat visitors.

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    ExpiresByType video/mp4 "access plus 7 days"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
